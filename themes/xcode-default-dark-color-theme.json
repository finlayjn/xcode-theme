        "source.swift keyword.other.attribute"
      ],
      "settings": {
        "foreground": "#BF8555"
      }
    },
    // Rust
    {
      "name": "Rust lifetimes",
      "scope": [
        "storage.modifier.lifetime.rust",
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#BF8555"
      }
    },
    {
      "name": "Rust macros",
      "scope": [
        "entity.name.function.macro.rust",
        "support.macro.rust"
      ],
      "settings": {
        "foreground": "#FD8F3F"
      }
    },
    // Go
    {
      "name": "Go package names",
      "scope": [
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#9EF1DD"
      }
    },
    // C/C++
    {
      "name": "C/C++ preprocessor includes",
      "scope": [
        "keyword.control.directive.include",
        "keyword.control.directive.define",
        "keyword.control.directive.conditional",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#FD8F3F"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#9EF1DD",
